<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.recall</groupId>
        <artifactId>recall-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>recall-jev-sdk</artifactId>
    <packaging>jar</packaging>
    <name>recall-jev-sdk</name>
    <description>jev 模型（TypeSafe System One）Java SDK：独立 Maven 模块，Spring Boot 自动装配，recall.jev.enabled 开关控制</description>

    <dependencies>
        <!-- Spring Boot 自动装配（@Configuration/@ConfigurationProperties/@ConditionalOnProperty） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- JSON 序列化（与主应用同用 Jackson，由 spring-boot-starter-parent 统一管版本） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
